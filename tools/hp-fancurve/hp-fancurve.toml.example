# /etc/hp-fancurve.toml: every key is optional; missing keys use the built-in defaults.
# Curves are [temperature C, pwm %] points per fan, interpolated linearly. The
# temperature is the higher of the CPU (k10temp/coretemp) and amdgpu sensors.
# The driver clamps low pwm values to the fan table minimum (2300 RPM on board 8934).

interval = 2.0             # seconds between steps
critical = 92              # at or above: max fan mode
critical_hysteresis = 7    # leave max mode below critical - this
down_delay = 8.0           # a lower target must hold this long before ramping down
down_step = 4              # max pwm % drop per step
min_change = 2             # ignore upward changes smaller than this (pwm %)

[curves.quiet]
fan1 = [[55, 35], [70, 50], [80, 70], [88, 100]]
fan2 = [[55, 35], [70, 50], [80, 70], [88, 100]]

[curves.balanced]
fan1 = [[50, 35], [65, 50], [75, 70], [85, 90], [90, 100]]
fan2 = [[50, 35], [65, 50], [75, 70], [85, 90], [90, 100]]

[curves.performance]
fan1 = [[45, 40], [60, 60], [70, 80], [80, 100]]
fan2 = [[45, 40], [60, 60], [70, 80], [80, 100]]
